{
  "name": "dsh-maestro-codex",
  "version": "0.1.4",
  "description": "dsh 的 CLI 子代理编排：把任务按类型派发给 codex cli 或 claude cli（headless），取回执行结果回填主会话；配置页管理路由表、每个 CLI 的权限与模型，以及 CLI 本身的安装/更新/卸载。",
  "keywords": [
    "dsh",
    "deepseek",
    "cordis",
    "plugin",
    "codex",
    "claude",
    "cli",
    "subagent",
    "orchestration"
  ],
  "license": "MIT",
  "author": "GaoHu1997 (奋斗的小高) <gaohu9712@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GaoHu1997/dsh-maestro-codex.git"
  },
  "homepage": "https://github.com/GaoHu1997/dsh-maestro-codex#readme",
  "bugs": "https://github.com/GaoHu1997/dsh-maestro-codex/issues",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/**/*.map",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg",
    "locale/*.json",
    "THIRD_PARTY_NOTICES"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "prebuild": "node scripts/build-upstream.mjs",
    "pretypecheck": "node scripts/build-upstream.mjs",
    "pretest": "node scripts/build-upstream.mjs",
    "test:upstream": "node scripts/build-upstream.mjs && vitest run tests/upstream-"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.1 <0.3.0-0 || >=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.1 <0.3.0-0 || >=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.3",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "tsdown": "^0.14.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.32"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
